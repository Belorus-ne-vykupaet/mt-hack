FROM node:22-alpine
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY server ./server
COPY src ./src
COPY contracts ./contracts
RUN mkdir -p server/data && chown -R node:node server/data
USER node
EXPOSE 8081
ENV NODE_EXTRA_CA_CERTS=/app/server/certs/russian-trusted-root-ca.pem
CMD ["./node_modules/.bin/tsx", "--env-file-if-exists=server/weather-demo.env", "--env-file-if-exists=server/.env", "server/index.ts"]
