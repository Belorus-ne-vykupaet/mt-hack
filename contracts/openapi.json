  "components": {
    "schemas": {
      "PositionDto": {
        "type": "object",
        "properties": {
          "lat": {
            "type": "number"
          },
          "lon": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ]
      },
      "StopDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sequence": {
            "type": "integer"
          },
          "position": {
            "$ref": "#/components/schemas/PositionDto"
          }
        },
        "required": [
          "id",
          "name",
          "sequence",
          "position"
        ]
      },
      "RouteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "transport_type": {
            "type": "string",
            "enum": [
              "bus",
              "tram",
              "trolleybus",
              "other"
            ]
          },
          "current_delay_sec": {
            "type": "number",
            "nullable": true
          },
          "predicted_delay_sec": {
            "type": "number",
            "nullable": true
          },
          "risk_probability": {
            "type": "number",
            "nullable": true
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "normal",
              "elevated",
              "high",
              "critical",
              "unknown"
            ]
          },
          "vehicle_count": {
            "type": "integer"
          },
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StopDto"
            }
          },
          "forecast_status": {
            "type": "string",
            "enum": [
              "ready",
              "fallback",
              "no_schedule",
              "no_target",
              "stale_gps",
              "unavailable"
            ],
            "description": "Absent for legacy/demo data. Missing forecasts remain visible on the map."
          }
        },
        "required": [
          "id",
          "number",
          "name",
          "transport_type",
          "current_delay_sec",
          "predicted_delay_sec",
          "risk_probability",
          "risk_level",
          "vehicle_count",
          "stops"
        ]
      },
      "VehicleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "route_id": {
            "type": "string"
          },
          "position": {
            "$ref": "#/components/schemas/PositionDto"
          },
          "bearing_deg": {
            "type": "number"
          },
          "speed_kmh": {
            "type": "number"
          },
          "current_delay_sec": {
            "type": "number",
            "nullable": true
          },
          "predicted_delay_sec": {
            "type": "number",
            "nullable": true
          },
          "risk_probability": {
            "type": "number",
            "nullable": true
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "normal",
              "elevated",
              "high",
              "critical",
              "unknown"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "stopped",
              "inactive",
              "unknown",
              "stale"
            ]
          },
          "next_stop": {
            "allOf": [
              {
                "$ref": "#/components/schemas/StopDto"
              }
            ],
            "nullable": true
          },
          "updated_at": {
            "type": "string"
          },
          "forecast_horizon_sec": {
            "type": "number",
            "description": "Exact target-stop horizon in (600,900] seconds for official model.",
            "nullable": true
          },
          "forecast_target_time": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "forecast_model": {
            "type": "string",
            "nullable": true
          },
          "forecast_status": {
            "type": "string",
            "enum": [
              "ready",
              "fallback",
              "no_schedule",
              "no_target",
              "stale_gps",
              "unavailable"
            ],
            "description": "Absent for legacy/demo data. Missing forecasts remain visible on the map."
          },
          "telemetry_age_sec": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "route_id",
          "position",
          "bearing_deg",
          "speed_kmh",
          "current_delay_sec",
          "predicted_delay_sec",
          "risk_probability",
          "risk_level",
          "status",
          "next_stop",
          "updated_at"
        ]
      },
      "AlertDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "high",
              "critical"
            ]
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "route_id": {
            "type": "string"
          },
          "vehicle_id": {
            "type": "string"
          },
          "risk_probability": {
            "type": "number"
          },
          "predicted_delay_sec": {
            "type": "number"
          },
          "created_at": {
            "type": "string"
          },
          "target_time": {
            "type": "string",
            "description": "Planned target-stop arrival; same clock as the source CSV."
          },
          "expected_arrival_at": {
            "type": "string",
            "description": "Planned arrival plus signed predicted delay."
          },
          "lead_time_sec": {
            "type": "number",
            "description": "Seconds from the first alert publication to the planned target."
          },
          "observed_factor": {
            "type": "string",
            "description": "Observed signal, not a causal explanation of the model."
          },
          "model_status": {
            "type": "string",
            "enum": ["ready", "fallback"]
          }
        },
        "required": [
          "id",
          "severity",
          "type",
          "title",
          "description",
          "route_id",
          "vehicle_id",
          "risk_probability",
          "predicted_delay_sec",
          "created_at"
        ]
      },
      "NetworkSummaryDto": {
        "type": "object",
        "properties": {
          "vehicles_total": {
            "type": "number"
          },
          "vehicles_active": {
            "type": "number"
          },
          "routes_active": {
            "type": "number"
          },
          "on_time_percent": {
            "type": "number"
          },
          "at_risk_percent": {
            "type": "number"
          },
          "delayed_percent": {
            "type": "number"
          },
          "average_delay_sec": {
            "type": "number"
          },
          "average_predicted_delay_sec": {
            "type": "number"
          },
          "timestamp": {
            "type": "string"
          },
          "vehicles_located": {
            "type": "number",
            "minimum": 0
          },
          "vehicles_stale": {
            "type": "number",
            "minimum": 0
          },
          "vehicles_predicted": {
            "type": "number",
            "minimum": 0
          },
          "vehicles_assessed": {
            "type": "number",
            "minimum": 0
          },
          "vehicles_without_position": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "vehicles_total",
          "vehicles_active",
          "routes_active",
          "on_time_percent",
          "at_risk_percent",
          "delayed_percent",
          "average_delay_sec",
          "average_predicted_delay_sec",
          "timestamp"
        ]
      },
      "GeometryDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "LineString"
            ]
          },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "required": [
          "type",
          "coordinates"
        ]
      },
      "GeometryPropertiesDto": {
        "type": "object",
        "properties": {
          "route_id": {
            "type": "string"
          },
          "observed_paths": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            },
            "description": "Observed GPS path sections up to archive time; gaps and jumps are not connected."
          }
        },
        "required": [
          "route_id"
        ]
      },
      "RouteGeometryDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Feature"
            ]
          },
          "properties": {
            "$ref": "#/components/schemas/GeometryPropertiesDto"
          },
          "geometry": {
            "$ref": "#/components/schemas/GeometryDto"
          }
        },
        "required": [
          "type",
          "properties",
          "geometry"
        ]
      },
      "SegmentDto": {
        "type": "object",
