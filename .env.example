VITE_DATA_SOURCE=mock
VITE_API_URL=/api/v1
# Empty uses same-origin WebSocket proxy to the API service.
VITE_WS_URL=
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_DARK_STYLE_URL=https://tiles.openfreemap.org/styles/dark
# Use csv to replay data prepared with pnpm data:import.
VITE_MOCK_SCENARIO=route-primary-delay
VITE_DEBUG=false
VITE_VISUAL_TEST_MODE=false

# API dispatcher endpoints; use false for an older read-only backend.
VITE_DISPATCH_API=true
# Optional separate integration gateway; default follows API_URL in API mode.
VITE_INTEGRATION_URL=
