API_HOST=127.0.0.1
API_PORT=8081
API_JOURNAL=server/data/commands.json
API_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
# Required for a non-loopback listener; 24+ letters/digits/_/-. Never use a VITE_ variable.
API_TOKEN=
WEATHER_ENABLED=true
YANDEX_ROUTER_KEY=
# Full POST endpoint of your prediction service, e.g. http://127.0.0.1:8000/predict
ML_SERVICE_URL=
ML_SERVICE_TOKEN=
API_FROZEN=false

# Яндекс Погода: обычный ключ для текущей погоды по точкам (только сервер)
YANDEX_WEATHER_KEY=
