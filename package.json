{
  "name": "transit-control",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:generate": "orval",
    "typecheck": "tsc -b --pretty false",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm api:typecheck && pnpm lint && pnpm test:run && pnpm build",
    "routes:stops": "node scripts/routes-admin.mjs stops",
    "routes:add": "node scripts/routes-admin.mjs add",
    "routes:import": "node scripts/routes-admin.mjs import",
    "routes:validate": "node scripts/routes-admin.mjs validate",
    "data:generate": "python3 scripts/generate-csv.py",
    "data:check": "node scripts/import-csv.mjs --check",
    "data:import": "node scripts/import-csv.mjs",
    "test:csv": "playwright test --config playwright.csv.config.ts",
    "api:serve": "NODE_EXTRA_CA_CERTS=server/certs/russian-trusted-root-ca.pem tsx --env-file-if-exists=server/weather-demo.env --env-file-if-exists=server/.env server/index.ts",
    "api:typecheck": "tsc -p tsconfig.server.json --noEmit",
    "demo": "pnpm build && node scripts/start-demo.mjs",
    "test:api": "playwright test --config playwright.api.config.ts",
    "hackathon": "node scripts/start-hackathon.mjs",
    "docker:official": "node scripts/start-official-docker.mjs",
    "ml:train": "PYTHONPATH=ml ml/.venv/bin/python -m transit_ml.train",
    "ml:sasha:features": "PYTHONPATH=src ml/.venv/bin/python -m mt_hack.features --data ml/data/official --out ml/data/sasha-features",
    "ml:sasha:train": "PYTHONPATH=src ml/.venv/bin/python -m mt_hack.train --features ml/data/sasha-features --out ml/artifacts/sasha --reports reports",
    "ml:sasha:submission": "PYTHONPATH=src ml/.venv/bin/python -m mt_hack.predict --data ml/data/official --model ml/artifacts/sasha --out ml/artifacts/submission-sasha.csv",
    "ml:test": "PYTHONPATH=ml:src sh -c 'if [ -x ml/.venv/bin/python ]; then py=ml/.venv/bin/python; elif [ -x .venv/bin/python ]; then py=.venv/bin/python; else echo \"Create ml/.venv or .venv first\" >&2; exit 1; fi; exec \"$py\" -m pytest ml/tests tests/test_causality.py tests/test_submission.py -q'"
  },
  "dependencies": {
    "@deck.gl/core": "^9.3.0",
    "@deck.gl/extensions": "^9.3.0",
    "@deck.gl/geo-layers": "^9.3.0",
    "@deck.gl/layers": "^9.3.0",
    "@deck.gl/maplibre": "^9.3.0",
    "@deck.gl/mesh-layers": "^9.4.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@tanstack/react-query": "^5.90.0",
    "echarts": "^6.0.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.0",
    "three": "^0.186.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "msw": "^2.12.0",
    "orval": "^8.5.3",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
